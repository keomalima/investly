# Leave empty when Express serves the frontend on the same Render service.
VITE_API_BASE_URL=
# Optional public demo account. Create it through Register after deployment.
# Never reuse a personal account password here; VITE values are public.
VITE_DEMO_USER_EMAIL=
VITE_DEMO_USER_PASSWORD=
# Optional EmailJS login notifications.
VITE_SERVICE_ID=
VITE_TEMPLATE_ID=
VITE_PUBLIC_KEY=
